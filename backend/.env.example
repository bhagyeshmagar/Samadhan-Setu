# Firebase Configuration
# Update with path to your service account JSON file
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# JWT Secret (change in production)
SECRET_KEY=samadhan-setu-secret-key-change-in-production

# AI Services Configuration
# SBERT_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# SIMILARITY_THRESHOLD=0.75
# DUPLICATE_THRESHOLD=0.90
# Classification Service Configuration
# CLASSIFICATION_MODEL_NAME=typeform/distilbert-base-uncased-mnli
# CLASSIFICATION_CONFIDENCE_THRESHOLD=0.60
# USE_ML_CLASSIFIER=True

# EMBEDDING_BATCH_SIZE=32

# ── Object Storage (H3) ──────────────────────────────────────────────────────
# Leave S3_BUCKET empty to use local disk storage (default for development).
# Set S3_BUCKET to enable S3-compatible object storage (AWS S3, MinIO, Cloudflare R2…).
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
# Presigned URL expiry in seconds (default 1 hour)
S3_PRESIGN_EXPIRES=3600
