# ==============================================================================
# SAMADHAN SETU — Backend Configuration Template (.env.example)
# Municipal Civic Grievance Redressal Architecture
# ==============================================================================

# ── Environment & Application ─────────────────────────────────────────────────
# Set to 'production', 'staging', or 'development'.
# In production, weak default secrets are strictly rejected at startup.
ENVIRONMENT=development
PROJECT_NAME="Samadhan Setu"
VERSION=1.0.0

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Async connection string for FastAPI application (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/samadhan_setu

# Synchronous connection string for Alembic schema migrations (psycopg2 driver)
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/samadhan_setu

# Connection pool sizing (right-sized for multi-worker scaling)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false

# ── Security & Authentication ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Production MUST be at least 32 characters long.
SECRET_KEY=samadhan-setu-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# For local development without changing the default secret key:
# ALLOW_INSECURE_DEV=1

# ── CORS & Reverse Proxy ──────────────────────────────────────────────────────
# Comma-separated allowed frontend origins (whitespace automatically stripped)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Trusted reverse proxy IPs for X-Forwarded-For evaluation (Nginx, Traefik, Caddy, Cloudflare)
TRUSTED_PROXY_IPS=127.0.0.1,::1

# ── Redis Cache & Distributed Rate Limiting (Optional) ────────────────────────
# Required for multi-worker Uvicorn / Gunicorn scaling.
# If omitted or unreachable, automatically falls back to thread-safe in-memory sliding window.
REDIS_URL=redis://localhost:6379/0

# ── Media & Object Storage ────────────────────────────────────────────────────
# Leave S3_BUCKET empty for local disk storage (/uploads directory).
# Set to enable S3-compatible cloud storage (AWS S3, MinIO, Cloudflare R2).
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_PRESIGN_EXPIRES=300

# Upload limits
MAX_UPLOAD_SIZE_BYTES=5242880
MAX_ATTACHMENTS_PER_COMPLAINT=5

# ── Event-Driven Notifications (SMTP) ─────────────────────────────────────────
# Configure with NIC Mail, Gmail App Password, or municipal Postfix relay.
# If empty, notifications gracefully log to server stdout without throwing errors.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=samadhan-setu@nic.in
SMTP_TLS=true

# ── AI & NLP Service Tuning ───────────────────────────────────────────────────
SBERT_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.75
DUPLICATE_THRESHOLD=0.90
CLASSIFICATION_MODEL_NAME=typeform/distilbert-base-uncased-mnli
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.60
USE_ML_CLASSIFIER=true
EMBEDDING_BATCH_SIZE=32
